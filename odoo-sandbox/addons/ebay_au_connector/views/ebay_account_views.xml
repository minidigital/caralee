<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ebay_au_account_list" model="ir.ui.view">
        <field name="name">ebay.au.account.list</field>
        <field name="model">ebay.au.account</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="environment"/>
                <field name="marketplace_id"/>
                <field name="state"/>
                <field name="last_order_sync"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_ebay_au_account_form" model="ir.ui.view">
        <field name="name">ebay.au.account.form</field>
        <field name="model">ebay.au.account</field>
        <field name="arch" type="xml">
            <form string="eBay Australia Account">
                <header>
                    <button name="action_connect_ebay" type="object" string="Connect to eBay" class="btn-primary" invisible="state == 'connected'"/>
                    <button name="action_fetch_policies" type="object" string="Fetch Policies" invisible="state != 'connected'"/>
                    <button name="action_ensure_inventory_location" type="object" string="Ensure Location" invisible="state != 'connected'"/>
                    <button name="action_sync_orders" type="object" string="Import Orders" invisible="state != 'connected'"/>
                    <button name="action_disconnect" type="object" string="Disconnect" invisible="state != 'connected'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,connected,error"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_listings" type="object" class="oe_stat_button" icon="fa-tags">
                            <field name="listing_count" widget="statinfo" string="Listings"/>
                        </button>
                        <button name="action_view_orders" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="order_count" widget="statinfo" string="Orders"/>
                        </button>
                        <button name="action_view_products" type="object" class="oe_stat_button" icon="fa-cube">
                            <field name="product_count" widget="statinfo" string="Products"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="environment"/>
                            <field name="marketplace_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="client_id"/>
                            <field name="client_secret" password="True"/>
                            <field name="ru_name"/>
                            <field name="merchant_location_key"/>
                            <field name="default_category_id"/>
                        </group>
                    </group>
                    <group string="Business Policies" invisible="state != 'connected'">
                        <group>
                            <field name="payment_policy_id"/>
                            <field name="fulfillment_policy_id"/>
                        </group>
                        <group>
                            <field name="return_policy_id"/>
                            <field name="last_order_sync"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ebay_au_account" model="ir.actions.act_window">
        <field name="name">eBay Accounts</field>
        <field name="res_model">ebay.au.account</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
